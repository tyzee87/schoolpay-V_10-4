# SchoolPay V9 environment settings
SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
SESSION_TIMEOUT_MINUTES=120

SCHOOL_NAME=Your School
SCHOOL_ADDRESS=Kenya
SCHOOL_PHONE=

# First-run account passwords (optional; defaults remain for compatibility)
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_BURSAR_PASSWORD=change-this-bursar-password

# Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/mpesa/callback

# Optional callback protection. If set, append ?token=THE_SAME_VALUE
# to MPESA_CALLBACK_URL.
MPESA_CALLBACK_TOKEN=
